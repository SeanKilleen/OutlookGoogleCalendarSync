<Project Sdk="Microsoft.NET.Sdk">
  
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>OutlookGoogleCalendarSync</RootNamespace>
    <AssemblyName>OutlookGoogleCalendarSync</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableComHosting>false</EnableComHosting>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <Configurations>Debug;Release</Configurations>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <IsPublishable>true</IsPublishable>
    <Version>2.5.0</Version>
    <AssemblyVersion>2.5.0.0</AssemblyVersion>
    <FileVersion>2.5.0.0</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x86'">
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <!-- Office Interop via NuGet (required for .NET 8) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Office.Interop.Outlook" Version="15.0.4797.1004" />
  </ItemGroup>

  <!-- NuGet Package References -->
  <ItemGroup>
    <!-- Google API Packages -->
    <PackageReference Include="Google.Api.CommonProtos" Version="2.17.0" />
    <PackageReference Include="Google.Api.Gax" Version="4.13.0" />
    <PackageReference Include="Google.Api.Gax.Grpc" Version="4.13.0" />
    <PackageReference Include="Google.Apis" Version="1.73.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.73.0" />
    <PackageReference Include="Google.Apis.Calendar.v3" Version="1.73.0.3993" />
    <PackageReference Include="Google.Apis.Core" Version="1.73.0" />
    <PackageReference Include="Google.Cloud.DevTools.Common" Version="3.3.0" />
    <PackageReference Include="Google.Cloud.Logging.Log4Net" Version="4.4.0" />
    <PackageReference Include="Google.Cloud.Logging.Type" Version="4.3.0" />
    <PackageReference Include="Google.Cloud.Logging.V2" Version="4.5.0" />
    <PackageReference Include="Google.LongRunning" Version="3.5.0" />
    <PackageReference Include="Google.Protobuf" Version="3.33.5" />
    
    <!-- gRPC Packages -->
    <PackageReference Include="Grpc.Auth" Version="2.76.0" />
    <PackageReference Include="Grpc.Core" Version="2.46.6" />
    <PackageReference Include="Grpc.Core.Api" Version="2.76.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.76.0" />
    <PackageReference Include="Grpc.Net.Common" Version="2.76.0" />
    
    <!-- Common Packages -->
    <PackageReference Include="log4net" Version="3.2.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NodaTime" Version="3.3.0" />
    <PackageReference Include="System.Net.Http.WinHttpHandler" Version="10.0.2" />
    
    <!-- Microsoft Extensions -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
  </ItemGroup>

  <!-- Local DLL References (Squirrel-related - to be replaced later) -->
  <ItemGroup>
    <Reference Include="ClickOnceToSquirrelMigrator">
      <HintPath>lib\Squirrel\ClickOnceToSquirrelMigrator.dll</HintPath>
    </Reference>
    <Reference Include="DeltaCompressionDotNet">
      <HintPath>lib\Squirrel\DeltaCompressionDotNet.dll</HintPath>
    </Reference>
    <Reference Include="DeltaCompressionDotNet.MsDelta">
      <HintPath>lib\Squirrel\DeltaCompressionDotNet.MsDelta.dll</HintPath>
    </Reference>
    <Reference Include="DeltaCompressionDotNet.PatchApi">
      <HintPath>lib\Squirrel\DeltaCompressionDotNet.PatchApi.dll</HintPath>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>lib\Squirrel\Mono.Cecil.dll</HintPath>
    </Reference>
    <Reference Include="Mono.Cecil.Mdb">
      <HintPath>lib\Squirrel\Mono.Cecil.Mdb.dll</HintPath>
    </Reference>
    <Reference Include="Mono.Cecil.Pdb">
      <HintPath>lib\Squirrel\Mono.Cecil.Pdb.dll</HintPath>
    </Reference>
    <Reference Include="Mono.Cecil.Rocks">
      <HintPath>lib\Squirrel\Mono.Cecil.Rocks.dll</HintPath>
    </Reference>
    <Reference Include="NuGet.Squirrel">
      <HintPath>lib\Squirrel\NuGet.Squirrel.dll</HintPath>
    </Reference>
    <Reference Include="SharpCompress">
      <HintPath>lib\Squirrel\SharpCompress.dll</HintPath>
    </Reference>
    <Reference Include="Splat">
      <HintPath>lib\Squirrel\Splat.dll</HintPath>
    </Reference>
    <Reference Include="Squirrel">
      <HintPath>lib\Squirrel\Squirrel.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Content Files -->
  <ItemGroup>
    <Content Include="icon.ico" />
    <None Include="logger.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="tzdb.nzd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="app.config" />
  </ItemGroup>

  <!-- Protobuf files -->
  <ItemGroup>
    <None Include="protos\*.proto" />
  </ItemGroup>

  <!-- Copy native libraries for gRPC -->
  <ItemGroup>
    <None Include="lib\native\**\*.*">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
